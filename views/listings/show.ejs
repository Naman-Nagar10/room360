<% layout('/layouts/boilerplate') -%>
<div class="row">
    <div class="col-8 offset-3">
        <h1>Listing Details</h1>
    </div>

    <div class="card col-6 offset-3" >
        <img src="<%= listing.image %>" class="card-img-top show-img" alt=" listing_image ">

        <div class="card-body show-details">
            <p class="card-text">
                <h3><%= listing.title %></h3>
                <%= listing.description %><br>
                <strong>Price : </strong>₹ <%= listing.price.toLocaleString('en-IN') %>

                <div class="show-location">
                    <strong>Location : </strong><%= listing.location %> <br>
                    <strong>State : </strong><%= listing.state %>
                </div>
                <div class="show-type">
                    <strong>Type/Count/Gender : </strong><%= listing.type %>/<%= listing.sharing %>/<%= listing.gender %>
                </div>
            </p>
        </div>
    </div>


    <div class="show-btn">
        <a href="/listings/<%= listing._id %>/edit"
        class="btn btn-dark edit-btn col-1 offset-3">
        Edit</a>

        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button class="btn btn-dark dlt-btn  offset-5">
                Delete
            </button>
        </form>
    </div>
    
    
    
</div>
