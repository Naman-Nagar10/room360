<% layout('/layouts/boilerplate') -%>
<div class="row">
    <div class="col-8 offset-2">
        <h1>Edit Listing </h1>
        <br>

        <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
            <!-- TITLE -->
            <div class="mb-3">
                <label for="title" class="form-label">Title: </label>
                <input type="text" name="listing[title]" id="title" value="<%= listing.title %>" class="form-control" required>
            </div>

            <!-- DESCRIPTION -->
            <div class="mb-3">
                <label for="description" class="form-label">Description: </label>
                <textarea name="listing[description]" id="description" class="form-control" rows="3" cols="30" required><%= listing.description %></textarea>
            </div>

            <!-- IMAGE -->
            <div class="mb-3">
                <label for="image" class="form-label">Image: </label>
                <input type="text" name="listing[image]" id="image" value="<%= listing.image %>" class="form-control" required>
            </div>

            <!-- PRICE AND TYPE(SAME ROW) -->
            <div class="row">
                <div class="mb-3 col-md-4">    
                    <label for="price" class="form-label">Price: </label>
                    <input type="number" name="listing[price]" id="price" value="<%= listing.price %>" class="form-control" required>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="type" class="form-label">Type: </label>
                    <select name="listing[type]" id="type" class="form-select" required>
                        <option value="">Select Type</option>
                        <option value="PG" <% if (listing.type === "PG") { %>selected<% } %>>
                            PG
                        </option>
                        <option value="Hostel" <% if (listing.type === "Hostel") { %>selected<% } %>>
                            Hostel
                        </option>
                        <option value="Room" <% if (listing.type === "Room") { %>selected<% } %>>
                            Room
                        </option>
                    </select>
                </div>
            </div>

            <!-- LOCATION -->
            <div class="mb-3">
                <label for="location" class="form-label">Location: </label>
                <input type="text" name="listing[location]" id="location" value="<%= listing.location %>" class="form-control" required>
            </div>

            <!-- STATE  -->
            <div class="mb-3">
                <label for="state" class="form-label">State: </label>
                <input type="text" name="listing[state]" id="state" value="<%= listing.state %>" class="form-control" required>
            </div>


            <!-- SHARING AND GENDER (SAME ROW) -->
            <div class="row">
                <div class="mb-3 col-md-7">
                    <label for="sharing" class="form-label">Sharing: </label>
                    <select name="listing[sharing]" id="sharing" class="form-select" required>
                        <option value="">Select Sharing Option</option>
                        <option value="Single" <% if (listing.sharing === "Single") { %>selected<% } %>>
                            Single
                        </option>
                        <option value="Double" <% if (listing.sharing === "Double") { %>selected<% } %>>
                            Double
                        </option>
                        <option value="Triple" <% if (listing.sharing === "Triple") { %>selected<% } %>>
                            Triple
                        </option>
                        <option value="four" <% if (listing.sharing === "four") { %>selected<% } %>>
                            Four
                        </option>
                        <option value="MoreThenFive" <% if (listing.sharing === "MoreThenFive") { %>selected<% } %>>
                            More Than Five
                        </option>
                    </select>
                </div>

                <div class="mb-3 col-md-5">
                    <label for="gender" class="form-label">Gender: </label>
                    <select name="listing[gender]" id="gender" class="form-select" required>
                        
                        <option value="">Select Gender</option>
                        <option value="Male" <% if (listing.gender === "Male") { %>selected<% } %>>
                            Boys
                        </option>
                        <option value="Female" <% if (listing.gender === "Female") { %>selected<% } %>>
                            Girls
                        </option>
                        <option value="Other" <% if (listing.gender === "Other") { %>selected<% } %>>
                            Boys/Girls
                        </option>
                    </select>
                </div>
            </div>

            <!-- BUTTON -->
            <div class="mb-3">
                <button class="btn btn-dark edit-btn" type="submit">Update Listing</button>
            </div>
            <br>
            
        </form>
    </div>
</div>
