<% layout('/layouts/boilerplate') -%>
<body>
    <h1>Edit Listing </h1>

    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
        <label for="title">Title: </label>
        <input type="text" name="listing[title]" id="title" value="<%= listing.title %>" required>
        <br><br>

        <label for="description">Description: </label>
        <textarea name="listing[description]" id="description" required rows="3" cols="30"><%= listing.description %></textarea>
        <br><br>

        <label for="price">Price: </label>
        <input type="number" name="listing[price]" id="price" value="<%= listing.price %>" required>
        <br><br>

        <label for="location">Location: </label>
        <input type="text" name="listing[location]" id="location" value="<%= listing.location %>" required>
        <br><br>

        <label for="state">State: </label>
        <input type="text" name="listing[state]" id="state" value="<%= listing.state %>" required>
        <br><br>

        <label for="type">Type: </label>
        <select name="listing[type]" id="type" required>
            <option value="">Select Type</option>
            <option value="PG" <% if (listing.type === "PG") { %>selected<% } %>>
                PG
            </option>
            <option value="Hostel" <% if (listing.type === "Hostel") { %>selected<% } %>>
                Hostel
            </option>
            <option value="Room" <% if (listing.type === "Room") { %>selected<% } %>>
                Room
            </option>
        </select>
        <br><br>

        <label for="sharing">Sharing: </label>
        <select name="listing[sharing]" id="sharing" required>
            <option value="">Select Sharing Option</option>
            <option value="Single" <% if (listing.sharing === "Single") { %>selected<% } %>>
                Single
            </option>
            <option value="Double" <% if (listing.sharing === "Double") { %>selected<% } %>>
                Double
            </option>
            <option value="Triple" <% if (listing.sharing === "Triple") { %>selected<% } %>>
                Triple
            </option>
            <option value="four" <% if (listing.sharing === "four") { %>selected<% } %>>
                Four
            </option>
            <option value="MoreThenFive" <% if (listing.sharing === "MoreThenFive") { %>selected<% } %>>
                More Than Five
            </option>
        </select>
        <br><br>

        <label for="gender">Gender: </label>
        <select name="listing[gender]" id="gender" required>
            
            <option value="">Select Gender</option>
            <option value="Male" <% if (listing.gender === "Male") { %>selected<% } %>>
                Boys
            </option>
            <option value="Female" <% if (listing.gender === "Female") { %>selected<% } %>>
                Girls
            </option>
            <option value="Other" <% if (listing.gender === "Other") { %>selected<% } %>>
                Boys/Girls
            </option>
        </select>
        <br><br>

        <button type="submit">Update Listing</button>
    </form>
</body>
