<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Listing</title>
</head>
<body>
    <h1>Create New Listing </h1>

    <form action="/listings" method="POST">
        <label for="title">Title: </label>
        <input type="text" name="listing[title]" id="title" placeholder="Triple Sharing PG" required>
        <br><br>

        <label for="description">Description: </label>
        <textarea name="listing[description]" id="description" required rows="3" cols="30" placeholder="Enter listing description"></textarea>
        <br><br>

        <label for="price">Price: </label>
        <input type="number" name="listing[price]" id="price" required placeholder="₹ 100">
        <br><br>

        <label for="location">Location: </label>
        <input type="text" name="listing[location]" id="location" required placeholder="Mandi Road, Muzaffarnagar">
        <br><br>

        <label for="state">State: </label>
        <input type="text" name="listing[state]" id="state" required placeholder="Uttar Pradesh">
        <br><br>

        <label for="type">Type: </label>
        <select name="listing[type]" id="type" required>
            <option value="">Select Type</option>
            <option value="PG">PG</option>
            <option value="Hostel">Hostel</option>
            <option value="Room">Room</option>
        </select>
        <br><br>

        <label for="sharing">Sharing: </label>
        <select name="listing[sharing]" id="sharing" required>
            <option value="">Select Sharing Option</option>
            <option value="Single">Single</option>
            <option value="Double">Double</option>
            <option value="Triple">Triple</option>
            <option value="four">Four</option>
            <option value="MoreThenFive">More Than Five</option>
        </select>
        <br><br>

        <label for="gender">Gender: </label>
        <select name="listing[gender]" id="gender" required>
            
            <option value="">Select Gender</option>
            <option value="Male">Boys</option>
            <option value="Female">Girls</option>
            <option value="Other">Boys/Girls</option>
        </select>
        <br><br>

        <button type="submit">Create Listing</button>
    </form>
</body>
</html>